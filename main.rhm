#lang rhombus

import "main.rkt" as main
import "prompt.rkt" as pmt

import:
  rhombus/meta:
    open

expr.macro 'code($e)':
  'main.#{make-code}(main.#{code-text}($(e.to_source_string())), $e)'

fun model(proc, ~default_node_prompt = "Choose:"):
  main.model(proc, ~#{default-node-prompt}: default_node_prompt)

fun make_edge(name, ~mode = #false, ~is_half = #false, ~from, ~to, ~desc = #false, ~when: w = #false, ~trans = #false, ~priority = #false, ~options = []):
  main.#{make-edge}(name, ~mode, ~#{half?}: is_half, ~from, ~to, ~desc, ~when: w, ~trans, ~priority, ~options)

fun checker_config(~prompt = checker_prompt_config(), ~trace_display = #'hide):
  main.#{checker-config}(~prompt, ~#{trace-display}: trace_display)

fun checker_prompt_config(~string_values = main.#{default-checker-prompt-string-values},
                          ~integer_values = main.#{default-checker-prompt-integer-values},
                          ~natural_values = main.#{default-checker-prompt-natural-values},
                          ~positive_integer_values = main.#{default-checker-prompt-positive-integer-values},
                          ~between_values = main.#{default-checker-prompt-between-values},
                          ~random_values = main.#{default-checker-prompt-random-values}):
  main.#{checker-prompt-config}(~#{string-values}: string_values,
                                ~#{integer-values}: integer_values,
                                ~#{natural-values}: natural_values,
                                ~#{positive-integer-values}: positive_integer_values,
                                ~#{between-values}: between_values,
                                ~#{random-values}: random_values)

fun console_config(~commands = main.#{default-console-commands},
                   ~trace_display = #'show,
                   ~chooser = main.#{default-console-chooser}):
  main.#{console-config}(~commands, ~#{trace-display}: trace_display, ~chooser)

fun make_graph(name, ~parent_name = #false, ~desc = #false, ~edges):
  main.#{make-graph}(name, ~#{parent-name}: parent_name, ~desc, ~edges)

fun dot_config(~global = #false, ~node = #false, ~node_label = #false, ~edge_node = #false, ~edge_node_label = #false, ~edge = #false):
  main.#{dot-config}(~global, ~node, ~#{node-label}: node_label, ~#{edge-node}: edge_node, ~#{edge-node-label}: edge_node_label, ~edge)

export:
  code model make_edge make_graph checker_config checker_prompt_config console_config dot_config

  rename:
    main.message as message
    pmt.#{prompt/untyped} as prompt
    main.#{make-code} as make_code
    main.#{node-maker} as node_maker
    main.#{code-sexp} as code_sexp
    main.#{code-sexp?} as is_code_sexp
    main.#{code-sexp-sexp} as code_sexp_sexp
    main.#{code-text} as code_text
    main.#{code-text?} as is_code_text
    main.#{code-text-text} as code_text_text
    main.#{node-graph-name} as node_graph_name
    main.#{node-info-name} as node_info_name
    main.#{node-info-type} as node_info_type
    main.#{node-info-tags} as node_info_tags
    main.#{node-info-desc} as node_info_desc
    main.#{apply-journal} as apply_journal
    main.#{weight-edge-option} as weight_edge_option
    main.#{default-console-commands} as default_console_commands
    main.#{default-console-chooser} as default_console_chooser
    main.#{journal?} as is_journal
    main.#{prompt-info-tags} as prompt_info_tags
    main.#{console-run} as console_run
    main.#{find-counterexample} as find_counterexample
    main.#{find-deadlock} as find_deadlock
    main.#{find-false-terminal} as  find_false_terminal
    main.#{find-auto-conflict} as find_auto_conflict
    main.#{find-livelock} as find_livelock
    main.#{default-checker-prompt-string-values} as default_checker_prompt_string_values
    main.#{default-checker-prompt-integer-values} as default_checker_prompt_integer_values
    main.#{default-checker-prompt-natural-values} as default_checker_prompt_natural_values
    main.#{default-checker-prompt-positive-integer-values} as default_checker_prompt_positive_integer_values
    main.#{default-checker-prompt-between-values} as default_checker_prompt_between_values
    main.#{default-checker-prompt-random-values} as default_checker_prompt_random_values
    main.#{dot-node-name} as dot_node_name
    main.#{dot-node-desc} as dot_node_desc
    main.#{dot-node-type} as dot_node_type
    main.#{dot-node-prompt} as dot_node_prompt
    main.#{dot-node-trans} as dot_node_trans
    main.#{dot-edge-name} as dot_edge_name
    main.#{dot-edge-desc} as dot_edge_desc
    main.#{dot-edge-from} as dot_edge_from
    main.#{dot-edge-to} as dot_edge_to
    main.#{dot-edge-when} as dot_edge_when
    main.#{dot-edge-trans} as dot_edge_trans
    main.#{render-dot} as render_dot
    main.#{dot-global-config} as dot_global_config
    main.#{dot-node-config} as dot_node_config
    main.#{dot-edge-config} as dot_edge_config
    main.#{default-dot-node-config} as default_dot_node_config
    main.#{default-dot-edge-node-config} as default_dot_edge_node_config
    main.#{default-dot-edge-config} as default_dot_edge_config
    main.#{default-dot-node-label-config} as default_dot_node_label_config
    main.#{default-dot-edge-node-label-config} as default_dot_edge_node_label_config
    main.#{dot-edge-option} as dot_edge_option
